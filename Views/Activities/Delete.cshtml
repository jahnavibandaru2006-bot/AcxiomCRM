@model AcxiomCRM.Models.Activity

@{
    ViewData["Title"] = "Delete Activity";
}

<h1>Delete Activity</h1>

<div class="alert alert-danger">
    <strong>Are you sure you want to delete this activity?</strong>
    This action cannot be undone.
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.Type</dd>

            <dt class="col-sm-3">Subject</dt>
            <dd class="col-sm-9">@Model.Subject</dd>

            <dt class="col-sm-3">Activity Date</dt>
            <dd class="col-sm-9">@Model.ActivityDate.ToString("dd-MM-yyyy HH:mm")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@(Model.Customer?.Name ?? "-")</dd>

            <dt class="col-sm-3">Lead</dt>
            <dd class="col-sm-9">@(Model.Lead?.Name ?? "-")</dd>

            <dt class="col-sm-3">Opportunity</dt>
            <dd class="col-sm-9">@(Model.Opportunity?.Name ?? "-")</dd>

        </dl>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                Delete Activity
            </button>

            <a asp-action="Index" class="btn btn-secondary ms-2">
                Cancel
            </a>

        </form>

    </div>
</div>
