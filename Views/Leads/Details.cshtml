@model AcxiomCRM.Models.Lead

@{
    ViewData["Title"] = "Lead Details";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<h1>Lead Details</h1>

<hr />

<div class="card shadow-sm">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">Lead Code</dt>
            <dd class="col-sm-9">@(Model.LeadCode ?? "-")</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(Model.Phone ?? "-")</dd>

            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@(Model.Company ?? "-")</dd>

            <dt class="col-sm-3">Source</dt>
            <dd class="col-sm-9">@(Model.Source ?? "-")</dd>

            <dt class="col-sm-3">Priority</dt>
            <dd class="col-sm-9">@Model.Priority</dd>

            <dt class="col-sm-3">Expected Value</dt>
            <dd class="col-sm-9">
                @(Model.ExpectedValue.HasValue
                    ? Model.ExpectedValue.Value.ToString("C")
                    : "-")
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Assigned To</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.AssignedTo)
                    ? "Unassigned"
                    : Model.AssignedTo)
            </dd>

            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">
                @(Model.Customer?.Name ?? "-")
            </dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Notes)
                    ? "-"
                    : Model.Notes)
            </dd>

            <dt class="col-sm-3">Created Date</dt>
            <dd class="col-sm-9">
                @Model.CreatedDate.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
            </dd>

        </dl>

        <div class="mt-4">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit
            </a>

            @if (Model.Status == "Qualified")
            {
                <a asp-action="Convert"
                   asp-route-id="@Model.Id"
                   class="btn btn-success ms-2">
                    Convert Lead
                </a>
            }

            <a asp-action="Index"
               class="btn btn-secondary ms-2">
                Back
            </a>

        </div>

    </div>
</div>
