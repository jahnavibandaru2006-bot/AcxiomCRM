@model IEnumerable<AcxiomCRM.Models.Lead>

@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Leads</h1>
        <p class="text-muted">Manage leads, assignments, statuses and conversions.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Create Lead
    </a>
</div>

<form asp-action="Index" method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">

            <div class="col-md-5">
                <label class="form-label">Search</label>
                <input name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Name, email or company" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>

                    @foreach (var item in (string[])ViewBag.Statuses)
                    {
                        if (ViewBag.Status as string == item)
                        {
                            <option value="@item" selected>@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">
                    Search
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Clear
                </a>
            </div>

        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No leads found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Company</th>
                            <th>Source</th>
                            <th>Priority</th>
                            <th>Expected Value</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @(item.LeadCode ?? "-")
                                </td>

                                <td>
                                    <strong>@item.Name</strong>
                                </td>

                                <td>
                                    @item.Email
                                </td>

                                <td>
                                    @(item.Company ?? "-")
                                </td>

                                <td>
                                    @(item.Source ?? "-")
                                </td>

                                <td>
                                    @item.Priority
                                </td>

                                <td>
                                    @(item.ExpectedValue.HasValue
                                        ? item.ExpectedValue.Value.ToString("C")
                                        : "-")
                                </td>

                                <td>
                                    @if (item.Status == "New")
                                    {
                                        <span class="badge bg-primary">New</span>
                                    }
                                    else if (item.Status == "Contacted")
                                    {
                                        <span class="badge bg-info text-dark">Contacted</span>
                                    }
                                    else if (item.Status == "Qualified")
                                    {
                                        <span class="badge bg-success">Qualified</span>
                                    }
                                    else if (item.Status == "Converted")
                                    {
                                        <span class="badge bg-dark">Converted</span>
                                    }
                                    else if (item.Status == "Lost")
                                    {
                                        <span class="badge bg-danger">Lost</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>

                                <td>
                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        @if (item.Status == "Qualified")
                                        {
                                            <a asp-action="Convert"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-success">
                                                Convert
                                            </a>
                                        }

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>
