@model AcxiomCRM.Models.Lead

@{
    ViewData["Title"] = "Delete Lead";
}

<h1>Delete Lead</h1>

<div class="alert alert-danger">
    <strong>Are you sure you want to delete this lead?</strong>
    This action cannot be undone.
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">Lead Code</dt>
            <dd class="col-sm-9">@(Model.LeadCode ?? "-")</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@(Model.Company ?? "-")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

        </dl>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <button type="submit"
                    class="btn btn-danger">
                Delete Lead
            </button>

            <a asp-action="Index"
               class="btn btn-secondary ms-2">
                Cancel
            </a>

        </form>

    </div>
</div>
