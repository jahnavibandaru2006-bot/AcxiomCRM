@model IEnumerable<AcxiomCRM.Models.UserManagementViewModel>

@{
    ViewData["Title"] = "User Management";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["CreatedUser"] != null)
{
    <div class="alert alert-success">
        <strong>User created successfully.</strong>
        <br />
        Email: @TempData["CreatedUser"]
        <br />
        Temporary Password:
        <strong>@TempData["TemporaryPassword"]</strong>
        <br />
        <small>
            Save this temporary password. It is generated only when the
            user is created.
        </small>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>User Management</h1>
        <p class="text-muted">
            Manage users, roles and account status.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + Create User
    </a>
</div>

<form asp-action="Index"
      method="get"
      class="card shadow-sm mb-4">

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-8">
                <label class="form-label">
                    Search User
                </label>

                <input name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search by email" />
            </div>

            <div class="col-md-4 d-flex align-items-end">

                <button type="submit"
                        class="btn btn-primary me-2">
                    Search
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Clear
                </a>

            </div>

        </div>

    </div>
</form>

<div class="card shadow-sm">

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No users found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Primary Role</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>
                                    @user.Email
                                </td>

                                <td>

                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">
                                            Admin
                                        </span>
                                    }
                                    else if (user.Role == "Manager")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Manager
                                        </span>
                                    }
                                    else if (user.Role == "SalesExecutive")
                                    {
                                        <span class="badge bg-primary">
                                            SalesExecutive
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @user.Role
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    @if (user.IsActive)
                                    {
                                        <form asp-action="ToggleActive"
                                              asp-route-id="@user.Id"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Deactivate
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleActive"
                                              asp-route-id="@user.Id"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Activate
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>
