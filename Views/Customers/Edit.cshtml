@model AcxiomCRM.Models.Customer

@{
    ViewData["Title"] = "Edit Customer";
}

<h1>Edit Customer</h1>

<hr />

<div class="row">
    <div class="col-md-7">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CustomerCode" />
            <input type="hidden" asp-for="CreatedDate" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CustomerCode" class="form-label">
                    Customer Code
                </label>

                <input asp-for="CustomerCode"
                       class="form-control"
                       readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">
                    Customer Name
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control"
                       type="email" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">
                    Phone
                </label>

                <input asp-for="Phone"
                       class="form-control" />

                <span asp-validation-for="Phone"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Company" class="form-label">
                    Company
                </label>

                <input asp-for="Company"
                       class="form-control" />
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="City" class="form-label">
                        City
                    </label>

                    <input asp-for="City"
                           class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="State" class="form-label">
                        State
                    </label>

                    <input asp-for="State"
                           class="form-control" />
                </div>

            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">
                    Address
                </label>

                <textarea asp-for="Address"
                          class="form-control"
                          rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label">
                    Status
                </label>

                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>

                <span asp-validation-for="Status"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AssignedTo" class="form-label">
                    Sales Executive
                </label>

                <select asp-for="AssignedTo"
                        class="form-select"
                        asp-items="ViewBag.AssignedTo">

                    <option value="">-- Unassigned --</option>

                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label">
                    Notes
                </label>

                <textarea asp-for="Notes"
                          class="form-control"
                          rows="4"></textarea>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-secondary ms-2">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
